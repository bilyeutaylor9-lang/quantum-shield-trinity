{
  "name": "quantum-shield-trinity",
  "version": "2.6.0",
  "description": "AI, Agent, MCP, RAG, Smart Contract, Blockchain, and Quantum Security Assessment Platform",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "quantum-shield": "./src/cli.js",
    "qst": "./src/cli.js"
  },
  "scripts": {
    "scan": "node src/cli.js",
    "qst": "node src/cli.js",

    "scan:deep": "node src/cli.js . --profile deep",
    "scan:quick": "node src/cli.js . --profile quick",
    "scan:ai": "node src/cli.js . --profile ai",
    "scan:blockchain": "node src/cli.js . --profile blockchain",
    "scan:quantum": "node src/cli.js . --profile quantum",

    "demo": "node src/examples/demo.js",
    "repo-demo": "node src/examples/repositoryDemo.js",
    "file-scan": "node src/examples/fileScanDemo.js",
    "rule-scan": "node src/examples/ruleScanDemo.js",

    "test": "node src/examples/demo.js",

    "report:html": "node src/examples/generateHtmlReport.js",
    "report:sarif": "node src/examples/generateSarifReport.js",

    "version:show": "node -e \"import('./package.json',{assert:{type:'json'}}).then(p=>console.log('Quantum Shield Trinity v'+p.default.version))\""
  },
  "keywords": [
    "ai-security",
    "agent-security",
    "ai-agent-security",
    "prompt-injection",
    "rag-security",
    "agent-memory-security",
    "mcp-security",
    "model-security",
    "smart-contract-security",
    "blockchain-security",
    "wallet-security",
    "crypto-security",
    "quantum-security",
    "post-quantum",
    "security-audit",
    "risk-assessment",
    "cybersecurity",
    "sast",
    "security-scanner",
    "github-security",
    "web3-security",
    "defi-security",
    "reactive-network"
  ],
  "author": "Taylor Bilyeu",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TaylorBilyeu/quantum-shield-trinity.git"
  },
  "bugs": {
    "url": "https://github.com/TaylorBilyeu/quantum-shield-trinity/issues"
  },
  "homepage": "https://github.com/TaylorBilyeu/quantum-shield-trinity",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
